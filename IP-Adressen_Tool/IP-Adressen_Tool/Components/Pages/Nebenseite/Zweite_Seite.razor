@page "/Zweite-Seite"
@using IP_Adressen_Tool.Components.Pages.Nebenseite
@using IP_Adressen_Tool.Components.Pages.Hauptwebseite
@using System.Net
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="seite">
    <div class="haupt-bereich">

        <a class="seiten-pfeil" href="/IP-Tool">
            <img src="image/pfeil-icon-svg-download-png-97525.png" alt="Pfeil" class="pfeil-bild-zurueck" />
            <span>Zurück zum IP-Rechner</span>
        </a>

        <div class="rechner">
            <h2>IPv6 CIDR-Subnetz-Rechner</h2>

            <div class="eingabe">
                <label>IPv6-Adresse:</label>
                <input type="text" class="ipv6-input" placeholder="2001:db8::1" @bind="ipInput" @bind:event="oninput" />

                <div class="cidr-zeile">
                    <label>CIDR-Präfix: /@prefixLength</label>
                </div>
                <input class="cidr-regler" type="range" min="0" max="128" @bind="prefixLength" @bind:event="oninput" />

                <button type="button" @onclick="Berechnen">Berechnen</button>

                @if (!string.IsNullOrEmpty(result.ErrorMessage))
                {
                    <div class="fehler">@result.ErrorMessage</div>
                }
            </div>

            @if (result.IsValid)
            {
                <div class="ergebnis">
                    <h3>Subnetz-Berechnungsergebnisse</h3>
                    <table>
                        <tr>
                            <td>Eingegebene IP / Präfix</td>
                            <td>@ipInput / /@prefixLength</td>
                        </tr>
                        <tr>
                            <td>Netzwerkadresse</td>
                            <td class="mono">@result.NetworkAddress</td>
                        </tr>
                        <tr>
                            <td>Letzte Host-Adresse</td>
                            <td class="mono">@result.LastHost</td>
                        </tr>
                        <tr>
                            <td>Gesamtanzahl Hosts</td>
                            <td>@result.TotalHosts</td>
                        </tr>
                        <tr>
                            <td>CIDR-Notation</td>
                            <td class="mono">@bereich?.CidrNotation</td>
                        </tr>
                        <tr>
                            <td>Erste Adresse (ausgeschrieben)</td>
                            <td class="mono">@bereich?.FirstAddressExpanded</td>
                        </tr>
                        <tr>
                            <td>Letzte Adresse (ausgeschrieben)</td>
                            <td class="mono">@bereich?.LastAddressExpanded</td>
                        </tr>
                        <tr>
                            <td>Anzahl /64-Netze</td>
                            <td>@bereich?.Networks64Text</td>
                        </tr>
                        <tr>
                            <td>IPv4 dotted-quad notation</td>
                            <td class="mono">@shortVersion</td>
                        </tr>
                    </table>

                    <div class="export-zeile">
                        <button type="button" class="ip-btn" @onclick="ExportTxt">TXT</button>
                        <button type="button" class="ip-btn" @onclick="ExportCsv">CSV</button>
                        <button type="button" class="ip-btn" @onclick="ExportJson">JSON</button>
                        <button type="button" class="ip-btn" onclick="window.print()">Drucken</button>
                    </div>
                </div>
            }

            <h3 class="zusatz-titel">EUI-64 aus MAC-Adresse</h3>
            <div class="eingabe">
                <label>MAC-Adresse:</label>
                <input type="text" class="ipv6-input" placeholder="00:11:22:33:44:55" @bind="macInput" @bind:event="oninput" />

                <label>IPv6-Präfix (optional, /64):</label>
                <input type="text" class="ipv6-input" placeholder="2001:db8:1:1::/64" @bind="euiPraefix" @bind:event="oninput" />

                <button type="button" @onclick="EuiBerechnen">EUI-64 berechnen</button>

                @if (euiResult is not null && !euiResult.IsValid)
                {
                    <div class="fehler">@euiResult.ErrorMessage</div>
                }
            </div>

            @if (euiResult is not null && euiResult.IsValid)
            {
                <div class="ergebnis">
                    <h3>EUI-64 Ergebnis</h3>
                    <table>
                        <tr>
                            <td>MAC-Adresse</td>
                            <td class="mono">@euiResult.Mac</td>
                        </tr>
                        <tr>
                            <td>Interface-ID (EUI-64)</td>
                            <td class="mono">@euiResult.InterfaceId</td>
                        </tr>
                        @if (euiResult.HatAdresse)
                        {
                            <tr>
                                <td>IPv6-Adresse (komprimiert)</td>
                                <td class="mono">@euiResult.AdresseKomprimiert</td>
                            </tr>
                            <tr>
                                <td>IPv6-Adresse (ausgeschrieben)</td>
                                <td class="mono">@euiResult.AdresseExpandiert</td>
                            </tr>
                        }
                    </table>
                </div>
            }
        </div>

    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Ip { get; set; }

    private string ipInput = "2001:db8::1";
    private string shortVersion = "";
    private int prefixLength = 64;
    private IPv6CIDRResult result = new();
    private IPv6BereichResult? bereich;

    private ExportIPv6? exportDaten;

    private string macInput = "";
    private string euiPraefix = "";
    private EUI64Result? euiResult;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(Ip))
        {
            var convResult = IPv4_zu_IPv6_Converter.Convert(Ip);
            if (convResult.IsValid)
            {
                ipInput = convResult.FullIPv6;
                shortVersion = convResult.MappedIPv6;
            }
        }
    }

    private void Berechnen()
    {
        result = IPv6_CIDR_Rechner.Calculate(ipInput, prefixLength);
        bereich = CIDR_Bereichs_Rechner_IPv6.Calculate(ipInput, prefixLength);
        exportDaten = result.IsValid ? ExportDatenBauen() : null;
    }

    private void EuiBerechnen()
    {
        euiResult = EUI64_Rechner.Berechne(macInput, euiPraefix);
    }

    // Fertige Werte zum Zeitpunkt von "Berechnen". Reverse-DNS und Standort gibt es für IPv6 nicht, die Felder bleiben leer.
    private ExportIPv6 ExportDatenBauen()
    {
        IPAddress adresse = IPAddress.Parse(ipInput.Trim());
        byte[] b = adresse.GetAddressBytes();

        return new ExportIPv6
        {
            Eingabe = ipInput.Trim(),
            Praefix = $"/{prefixLength}",
            Art = IPv6Art(adresse, b),
            Komprimiert = adresse.ToString(),
            Expandiert = string.Join(":", Enumerable.Range(0, 8).Select(i => $"{b[i * 2]:x2}{b[i * 2 + 1]:x2}")),
            Netz = result.NetworkAddress,
            LetzteAdresse = result.LastHost,
            Anzahl = result.TotalHosts.ToString(),
            EingebetteteIPv4 = adresse.IsIPv4MappedToIPv6 ? adresse.MapToIPv4().ToString() : ""
        };
    }

    private static string IPv6Art(IPAddress a, byte[] b)
    {
        if (a.Equals(IPAddress.IPv6Loopback)) return "Loopback";
        if (a.Equals(IPAddress.IPv6Any)) return "Unspezifiziert";
        if (a.IsIPv4MappedToIPv6) return "IPv4-gemappt (::ffff:0:0/96)";
        if (a.IsIPv6LinkLocal) return "Link-Local (fe80::/10)";
        if (a.IsIPv6Multicast) return "Multicast (ff00::/8)";
        if ((b[0] & 0xFE) == 0xFC) return "Unique Local (fc00::/7)";
        if (b[0] == 0x20 && b[1] == 0x01 && b[2] == 0x0d && b[3] == 0xb8) return "Dokumentation (2001:db8::/32)";
        if ((b[0] & 0xE0) == 0x20) return "Global Unicast (2000::/3)";
        return "Reserviert";
    }

    private async Task ExportTxt()
    {
        if (exportDaten is null) return;
        await Ergebnis_Export.HerunterladenAsync(JS, "ipv6-ergebnis.txt", Ergebnis_Export.IPv6Txt(new[] { exportDaten }), Ergebnis_Export.MimeTxt);
    }

    private async Task ExportCsv()
    {
        if (exportDaten is null) return;
        await Ergebnis_Export.HerunterladenAsync(JS, "ipv6-ergebnis.csv", Ergebnis_Export.IPv6Csv(new[] { exportDaten }), Ergebnis_Export.MimeCsv);
    }

    private async Task ExportJson()
    {
        if (exportDaten is null) return;
        await Ergebnis_Export.HerunterladenAsync(JS, "ipv6-ergebnis.json", Ergebnis_Export.IPv6Json(new[] { exportDaten }), Ergebnis_Export.MimeJson);
    }
}