@page "/Werkzeuge"
@rendermode InteractiveServer
@using System.Globalization
@inject IJSRuntime JS

<div class="seite">
    <div class="haupt-bereich">

        <a class="seiten-pfeil" href="/IP-Tool">
            <img src="image/pfeil-icon-svg-download-png-97525.png" alt="Pfeil" class="pfeil-bild-zurueck" />
            <span>Zurück zum IP-Rechner</span>
        </a>

        <div class="rechner">
            <h2>Werkzeuge</h2>

            <h3 class="zusatz-titel">IP-Bereich in CIDR-Netze umwandeln</h3>
            <div class="eingabe">
                <label>Von (IPv4):</label>
                <input type="text" class="ipv6-input" placeholder="192.168.0.0" @bind="von" @bind:event="oninput" />
                <label>Bis (IPv4):</label>
                <input type="text" class="ipv6-input" placeholder="192.168.1.255" @bind="bis" @bind:event="oninput" />
                <button type="button" @onclick="BereichUmwandeln">In CIDR umwandeln</button>

                @if (bereichResult is not null && !bereichResult.IsValid)
                {
                    <div class="fehler">@bereichResult.ErrorMessage</div>
                }
            </div>

            @if (bereichResult is not null && bereichResult.IsValid)
            {
                <div class="ergebnis">
                    <h3>Ergebnis: @bereichResult.Netze.Count Netz(e)</h3>
                    <table>
                        @for (int i = 0; i < bereichResult.Netze.Count; i++)
                        {
                            var netz = bereichResult.Netze[i];
                            <tr>
                                <td>Netz @(i + 1)</td>
                                <td><span class="mono">@netz.CidrNotation</span> (@netz.Anzahl.ToString("N0", CultureInfo.GetCultureInfo("de-DE")) Adressen)</td>
                            </tr>
                        }
                    </table>

                    <div class="export-zeile">
                        <button type="button" class="ip-btn" @onclick="ExportTxt">TXT</button>
                        <button type="button" class="ip-btn" @onclick="ExportCsv">CSV</button>
                        <button type="button" class="ip-btn" @onclick="ExportJson">JSON</button>
                        <button type="button" class="ip-btn" onclick="window.print()">Drucken</button>
                    </div>
                </div>
            }

            <h3 class="zusatz-titel">Überlappende Netze finden</h3>
            <div class="eingabe">
                <label>Netze (eines pro Zeile, IP/CIDR):</label>
                <textarea class="netz-text" rows="6" placeholder="10.0.0.0/24" @bind="netzText" @bind:event="oninput"></textarea>
                <button type="button" @onclick="UeberlappungenSuchen">Überlappungen suchen</button>

                @if (ueberlappung is not null && !ueberlappung.IsValid)
                {
                    <div class="fehler">@ueberlappung.ErrorMessage</div>
                }
                @if (ueberlappung is not null)
                {
                    foreach (var meldung in ueberlappung.Zeilenfehler)
                    {
                        <div class="fehler">@meldung</div>
                    }
                }
            </div>

            @if (ueberlappung is not null && ueberlappung.IsValid)
            {
                <div class="ergebnis">
                    <h3>Ergebnis</h3>
                    @if (ueberlappung.KeineUeberlappung)
                    {
                        <div class="zusatz-text">Keine Überlappung gefunden. Es wurden @ueberlappung.AnzahlNetze Netze geprüft.</div>
                    }
                    else
                    {
                        <table>
                            @foreach (var paar in ueberlappung.Paare)
                            {
                                <tr>
                                    <td>@paar.NetzA und @paar.NetzB</td>
                                    <td>Schnitt: <span class="mono">@paar.Schnitt</span> (@paar.SchnittBereich, @paar.SchnittAdressen.ToString("N0", CultureInfo.GetCultureInfo("de-DE")) Adressen)</td>
                                </tr>
                            }
                        </table>
                    }

                    @if (!string.IsNullOrEmpty(ueberlappung.Hinweis))
                    {
                        <div class="zusatz-text">@ueberlappung.Hinweis</div>
                    }
                </div>
            }

            <h3 class="zusatz-titel">VLSM: Netz nach Hostzahlen aufteilen</h3>
            <div class="eingabe">
                <label>Gesamtnetz (IP/CIDR):</label>
                <input type="text" class="ipv6-input" placeholder="192.168.0.0/24" @bind="vlsmNetz" @bind:event="oninput" />
                <label>Benötigte Hosts (eine Zahl pro Zeile):</label>
                <textarea class="netz-text" rows="5" placeholder="50" @bind="vlsmHosts" @bind:event="oninput"></textarea>
                <button type="button" @onclick="VlsmBerechnen">Aufteilen</button>

                @if (vlsmResult is not null && !vlsmResult.IsValid)
                {
                    <div class="fehler">@vlsmResult.ErrorMessage</div>
                }
            </div>

            @if (vlsmResult is not null && vlsmResult.IsValid)
            {
                <div class="ergebnis">
                    <h3>Ergebnis für @vlsmResult.Gesamtnetz</h3>
                    <div class="tabelle-rahmen">
                        <table class="stapel-tabelle">
                            <thead>
                                <tr>
                                    <th>Hosts</th>
                                    <th>Netz</th>
                                    <th>Erster Host</th>
                                    <th>Letzter Host</th>
                                    <th>Broadcast</th>
                                    <th>Nutzbar</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var zeile in vlsmResult.Zeilen)
                                {
                                    if (zeile.HatFehler)
                                    {
                                        <tr class="zeile-fehler">
                                            <td>@zeile.Hosts</td>
                                            <td colspan="5">@zeile.Fehler</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr>
                                            <td>@zeile.Hosts</td>
                                            <td class="mono">@zeile.CidrNotation</td>
                                            <td class="mono">@zeile.Erster</td>
                                            <td class="mono">@zeile.Letzter</td>
                                            <td class="mono">@zeile.Broadcast</td>
                                            <td>@zeile.Nutzbar</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="zusatz-text">
                        Vergeben: @vlsmResult.VergebeneAdressen.ToString("N0", CultureInfo.GetCultureInfo("de-DE")) von @vlsmResult.GesamtAdressen.ToString("N0", CultureInfo.GetCultureInfo("de-DE")) Adressen,
                        frei: @vlsmResult.FreieAdressen.ToString("N0", CultureInfo.GetCultureInfo("de-DE")).
                        Jedes Netz braucht Hosts + 2 Adressen, mindestens ein /30.
                    </div>

                    <div class="export-zeile">
                        <button type="button" class="ip-btn" @onclick="VlsmExportTxt">TXT</button>
                        <button type="button" class="ip-btn" @onclick="VlsmExportCsv">CSV</button>
                        <button type="button" class="ip-btn" @onclick="VlsmExportJson">JSON</button>
                        <button type="button" class="ip-btn" onclick="window.print()">Drucken</button>
                    </div>
                </div>
            }

            <h3 class="zusatz-titel">DNS-Abfrage</h3>
            <div class="eingabe">
                <label>IP-Adresse oder Hostname:</label>
                <input type="text" class="ipv6-input" placeholder="example.com oder 8.8.8.8" @bind="dnsEingabe" @bind:event="oninput" />
                <button type="button" @onclick="DnsAbfragen" disabled="@dnsLaeuft">Abfragen</button>
            </div>

            @if (dnsErgebnis is not null)
            {
                <div class="ergebnis">
                    <h3>DNS-Ergebnis</h3>
                    <div class="zusatz-text mono">@dnsErgebnis.Text</div>
                </div>
            }
        </div>

    </div>
</div>

@code {
    private string von = "192.168.0.0";
    private string bis = "192.168.1.255";
    private BereichZuCidrResult? bereichResult;
    private List<ExportVlsm> exportZeilen = new();

    private string netzText = "10.0.0.0/24\n10.0.0.128/25\n192.168.0.0/16";
    private UeberlappungResult? ueberlappung;

    private string vlsmNetz = "192.168.0.0/24";
    private string vlsmHosts = "50\n20\n10";
    private VlsmResult? vlsmResult;

    private string dnsEingabe = "";
    private DnsLookupResult? dnsErgebnis;
    private bool dnsLaeuft;

    private void BereichUmwandeln()
    {
        bereichResult = CIDR_Bereichs_Rechner_IPv4.BereichZuCidr(von, bis);
        exportZeilen = new List<ExportVlsm>();

        if (!bereichResult.IsValid) return;

        foreach (var netz in bereichResult.Netze)
        {
            SubnetResult s = Subnet_Calculator.Calculate(netz.Netz, netz.Cidr);
            exportZeilen.Add(new ExportVlsm
            {
                Netz = netz.Netz,
                CIDR = $"/{netz.Cidr}",
                Erster = s.FirstHost,
                Letzter = s.LastHost,
                Broadcast = s.BroadcastAddress,
                Nutzbar = s.UsableHosts.ToString(CultureInfo.InvariantCulture)
            });
        }
    }

    private void UeberlappungenSuchen()
    {
        ueberlappung = CIDR_Bereichs_Rechner_IPv4.FindeUeberlappungen(netzText);
    }

    private void VlsmBerechnen()
    {
        vlsmResult = VLSM_Rechner.Berechne(vlsmNetz, vlsmHosts);
    }

    private async Task DnsAbfragen()
    {
        dnsLaeuft = true;
        dnsErgebnis = new DnsLookupResult { Text = "Abfrage läuft …" };

        dnsErgebnis = await DNS_Lookup.AbfragenAsync(dnsEingabe);

        dnsLaeuft = false;
    }

    private async Task VlsmExportTxt()
    {
        if (vlsmResult is null) return;
        await Ergebnis_Export.HerunterladenAsync(JS, "vlsm.txt", Ergebnis_Export.VlsmTxt(vlsmResult.ExportListe()), Ergebnis_Export.MimeTxt);
    }

    private async Task VlsmExportCsv()
    {
        if (vlsmResult is null) return;
        await Ergebnis_Export.HerunterladenAsync(JS, "vlsm.csv", Ergebnis_Export.VlsmCsv(vlsmResult.ExportListe()), Ergebnis_Export.MimeCsv);
    }

    private async Task VlsmExportJson()
    {
        if (vlsmResult is null) return;
        await Ergebnis_Export.HerunterladenAsync(JS, "vlsm.json", Ergebnis_Export.VlsmJson(vlsmResult.ExportListe()), Ergebnis_Export.MimeJson);
    }

    private async Task ExportTxt()
    {
        await Ergebnis_Export.HerunterladenAsync(JS, "bereich-cidr.txt", Ergebnis_Export.VlsmTxt(exportZeilen), Ergebnis_Export.MimeTxt);
    }

    private async Task ExportCsv()
    {
        await Ergebnis_Export.HerunterladenAsync(JS, "bereich-cidr.csv", Ergebnis_Export.VlsmCsv(exportZeilen), Ergebnis_Export.MimeCsv);
    }

    private async Task ExportJson()
    {
        await Ergebnis_Export.HerunterladenAsync(JS, "bereich-cidr.json", Ergebnis_Export.VlsmJson(exportZeilen), Ergebnis_Export.MimeJson);
    }
}
